{
  "name": "Go Development Container",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:America/Los_Angeles}",
      "CLAUDE_CODE_VERSION": "latest",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.0",
      "GO_VERSION": "1.21"
    }
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "golang.go",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "go.formatTool": "goimports",
        "go.lintTool": "golangci-lint",
        "go.useLanguageServer": true,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "developer",
  "mounts": [
    "source=go-devcontainer-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=go-devcontainer-config-${devcontainerId},target=/home/developer/.claude,type=volume",
    "source=go-devcontainer-gopath-${devcontainerId},target=/go,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/developer/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "GOPATH": "/go",
    "PATH": "${containerEnv:PATH}:/go/bin"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "go mod download || true",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
